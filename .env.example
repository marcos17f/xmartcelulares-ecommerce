# Copie este arquivo para .env.local e preencha os valores.
# .env.local nunca é commitado (veja .gitignore).

# URL de produção do site (sem barra no final). Usado no sitemap, robots.txt e OG tags.
NEXT_PUBLIC_SITE_URL=https://www.xmartcelulares.com.br

# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX).
# Deixe em branco para não carregar o GA.
NEXT_PUBLIC_GA_ID=

# Sentry — monitoramento de erros. Deixe em branco para desativar.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry — só necessários para o upload de source maps no build (opcional).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
